/* -----------------------------------------------------
 * Asanagi Umi Theme - Rofi / App Launcher
 * ----------------------------------------------------- */

* {
    background: #130f1b;
    background-alt: #1e182b;
    foreground: #ddd6eb;
    selected: #b872e8;
    active: #f43f6e;
    urgent: #fb7185;
    border-color: #3b2c52;
    
    font: "JetBrainsMono Nerd Font 11";
}

window {
    transparency: "real";
    background-color: @background;
    text-color: @foreground;
    border: 2px solid;
    border-color: @selected;
    border-radius: 14px;
    width: 600px;
    padding: 16px;
}

mainbox {
    background-color: transparent;
    children: [ inputbar, listview ];
    spacing: 12px;
}

inputbar {
    background-color: @background-alt;
    text-color: @foreground;
    border: 1px solid;
    border-color: @border-color;
    border-radius: 10px;
    padding: 10px 14px;
    children: [ prompt, entry ];
}

prompt {
    background-color: transparent;
    text-color: @selected;
    margin: 0 8px 0 0;
}

entry {
    background-color: transparent;
    text-color: @foreground;
    placeholder: "Search applications or commands...";
    placeholder-color: #877b9f;
}

listview {
    background-color: transparent;
    columns: 1;
    lines: 7;
    cycle: true;
    dynamic: true;
    scrollbar: false;
    layout: vertical;
    spacing: 4px;
}

element {
    background-color: transparent;
    text-color: @foreground;
    orientation: horizontal;
    border-radius: 8px;
    padding: 8px 12px;
}

element selected.normal {
    background-color: @selected;
    text-color: #ffffff;
}

element-icon {
    size: 24px;
    margin: 0 10px 0 0;
    background-color: transparent;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    vertical-align: 0.5;
}
