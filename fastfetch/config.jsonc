{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "image",
        "source": "~/.config/omarchy/themes/asanagi/backgrounds/avatar.jpg",
        "width": 20,
        "height": 10,
        "padding": {
            "top": 1,
            "left": 1,
            "right": 2
        }
    },
    "display": {
        "separator": "  ",
        "color": {
            "keys": "magenta",
            "title": "bright_magenta"
        }
    },
    "modules": [
        {
            "type": "title",
            "format": "{user-name-colored} @ {host-name-colored}"
        },
        "break",
        {
            "type": "os",
            "key": "os  ",
            "keyColor": "38;2;168;85;247"
        },
        {
            "type": "kernel",
            "key": "krn ",
            "keyColor": "38;2;129;140;248"
        },
        {
            "type": "wm",
            "key": "wm  ",
            "keyColor": "38;2;244;63;110"
        },
        {
            "type": "shell",
            "key": "sh  ",
            "keyColor": "38;2;56;189;248"
        },
        {
            "type": "terminal",
            "key": "term",
            "keyColor": "38;2;74;222;128"
        },
        {
            "type": "memory",
            "key": "mem ",
            "keyColor": "38;2;250;204;21"
        },
        {
            "type": "uptime",
            "key": "up  ",
            "keyColor": "38;2;232;121;249"
        },
        "break",
        {
            "type": "colors",
            "symbol": "circle"
        }
    ]
}
