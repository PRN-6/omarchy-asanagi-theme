{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "small",
        "padding": {
            "top": 1,
            "left": 2,
            "right": 2
        }
    },
    "display": {
        "separator": " 󰄾 ",
        "color": {
            "keys": "magenta",
            "title": "bright_magenta"
        }
    },
    "modules": [
        {
            "type": "title",
            "format": "{user-name-colored} @ {host-name-colored} 🌸 [Asanagi Umi]"
        },
        "break",
        {
            "type": "os",
            "key": "󰣇 OS",
            "keyColor": "38;2;184;114;232"
        },
        {
            "type": "kernel",
            "key": "󰒋 Kernel",
            "keyColor": "38;2;129;140;248"
        },
        {
            "type": "wm",
            "key": " WM",
            "keyColor": "38;2;244;63;110"
        },
        {
            "type": "shell",
            "key": " Shell",
            "keyColor": "38;2;56;189;248"
        },
        {
            "type": "terminal",
            "key": " Term",
            "keyColor": "38;2;74;222;128"
        },
        {
            "type": "memory",
            "key": "󰍛 Memory",
            "keyColor": "38;2;250;204;21"
        },
        {
            "type": "uptime",
            "key": "󰅐 Uptime",
            "keyColor": "38;2;232;121;249"
        },
        "break",
        {
            "type": "colors",
            "symbol": "circle"
        }
    ]
}
